rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isDocOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isBoundedStringList(listVal, minSize, maxSize) {
      return listVal is list && listVal.size() >= minSize && listVal.size() <= maxSize;
    }

    function isValidNumberPos(val) {
      return (val is int || val is float) && val >= -1000000 && val <= 100000000;
    }

    // Group membership lookup on the parent /groups/{groupId} document.
    // Every member whose UID is in groups/{groupId}.memberUids (or adminId) has full shared access
    // to all students, blocks, cardEvents, monthlyBalances, and invitations in that group—
    // even if a child or block was created before a new servant joined!
    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        (
          uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == uid()
        );
    }

    // Admin check on the parent /groups/{groupId} document.
    // Delete operations on students and blocks are strictly restricted to the Group Admin.
    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == uid();
    }

    function groupAllowsServantUndo(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.allowServantUndo == true;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'email', 'groupId',
          'enabledCards', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'displayName', 'email', 'groupId', 'joinedGroupIds',
          'enabledCards', 'collapsedBlockIds', 'hiddenBlockIds',
          'compactViewMode', 'themeId', 'uiScaleMode', 'uiScaleFactor',
          'showFloatingAddButton', 'createdAt', 'updatedAt'
        ]) &&
        data.userId == uid() &&
        isNonEmptyString(data.displayName, 80) &&
        isOptionalString(data.email, 150) &&
        isOptionalString(data.groupId, 40) &&
        (!('joinedGroupIds' in data) || isBoundedStringList(data.joinedGroupIds, 0, 25)) &&
        isBoundedStringList(data.enabledCards, 0, 7) &&
        (!('collapsedBlockIds' in data) || isBoundedStringList(data.collapsedBlockIds, 0, 50)) &&
        (!('hiddenBlockIds' in data) || isBoundedStringList(data.hiddenBlockIds, 0, 50)) &&
        (!('compactViewMode' in data) || data.compactViewMode is bool) &&
        (!('themeId' in data) || isOptionalString(data.themeId, 40)) &&
        (!('uiScaleMode' in data) || isOptionalString(data.uiScaleMode, 20)) &&
        (!('uiScaleFactor' in data) || ((data.uiScaleFactor is int || data.uiScaleFactor is float) && data.uiScaleFactor >= 0.5 && data.uiScaleFactor <= 2.0)) &&
        (!('showFloatingAddButton' in data) || data.showFloatingAddButton is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGroup(data, groupId) {
      return data.keys().hasAll([
          'inviteCode', 'name', 'adminId', 'adminName', 'memberUids',
          'allowServantUndo', 'enforceWeeklyCardLimit', 'maxMonthlyPoints',
          'attendanceIsCardOnly', 'showLeaderboard', 'autoStudentNumber',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inviteCode', 'name', 'adminId', 'adminName', 'memberUids',
          'allowServantUndo', 'enforceWeeklyCardLimit', 'maxMonthlyPoints',
          'attendanceIsCardOnly', 'showLeaderboard', 'autoStudentNumber',
          'bannedUids', 'bannedServantEntries', 'dailyInviteToken', 'inviteCodeUpdatedAtMillis',
          'createdAt', 'updatedAt'
        ]) &&
        data.inviteCode == groupId &&
        isNonEmptyString(data.inviteCode, 20) &&
        isNonEmptyString(data.name, 80) &&
        isNonEmptyString(data.adminId, 64) &&
        isNonEmptyString(data.adminName, 80) &&
        isBoundedStringList(data.memberUids, 1, 10) &&
        data.adminId in data.memberUids &&
        data.allowServantUndo is bool &&
        data.enforceWeeklyCardLimit is bool &&
        data.maxMonthlyPoints is int && data.maxMonthlyPoints >= 0 && data.maxMonthlyPoints <= 5000 &&
        data.attendanceIsCardOnly is bool &&
        data.showLeaderboard is bool &&
        data.autoStudentNumber is bool &&
        (!('bannedUids' in data) || isBoundedStringList(data.bannedUids, 0, 50)) &&
        (!('bannedServantEntries' in data) || isBoundedStringList(data.bannedServantEntries, 0, 50)) &&
        (!('dailyInviteToken' in data) || isOptionalString(data.dailyInviteToken, 16)) &&
        (!('inviteCodeUpdatedAtMillis' in data) || (data.inviteCodeUpdatedAtMillis is int && data.inviteCodeUpdatedAtMillis >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvitation(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'groupName', 'adminId', 'inviteeName', 'inviteCode',
          'status', 'acceptedByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'groupName', 'adminId', 'inviteeName', 'inviteCode',
          'status', 'acceptedByUid', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.groupId == groupId &&
        isNonEmptyString(data.groupName, 80) &&
        isNonEmptyString(data.adminId, 64) &&
        isNonEmptyString(data.inviteeName, 80) &&
        data.inviteCode == groupId &&
        data.status in ['PENDING', 'ACCEPTED', 'REJECTED'] &&
        isOptionalString(data.acceptedByUid, 64) &&
        (!('memberUids' in data) || isBoundedStringList(data.memberUids, 1, 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServantBlock(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'servantId', 'servantName', 'colorHex',
          'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'servantId', 'servantName', 'colorHex',
          'sortOrder', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.groupId == groupId &&
        isOptionalString(data.servantId, 64) &&
        isNonEmptyString(data.servantName, 80) &&
        isNonEmptyString(data.colorHex, 24) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 500 &&
        (!('memberUids' in data) || isBoundedStringList(data.memberUids, 1, 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudent(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'name', 'studentNumber', 'blockId',
          'sortOrder', 'avatarInitials', 'createdByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'name', 'studentNumber', 'blockId',
          'sortOrder', 'position', 'avatarInitials', 'avatarBase64', 'createdByUid',
          'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.groupId == groupId &&
        isNonEmptyString(data.name, 100) &&
        data.studentNumber is int && data.studentNumber >= 1 && data.studentNumber <= 2000 &&
        isOptionalString(data.blockId, 80) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 5000 &&
        (!('position' in data) || isValidNumberPos(data.position)) &&
        isOptionalString(data.avatarInitials, 10) &&
        (!('avatarBase64' in data) || isOptionalString(data.avatarBase64, 50000)) &&
        isNonEmptyString(data.createdByUid, 64) &&
        (!('memberUids' in data) || isBoundedStringList(data.memberUids, 1, 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCardPointsPair(cardType, points) {
      return (cardType == 'ATTENDANCE' && points == 3) ||
             (cardType == 'QUIET' && points == 5) ||
             (cardType == 'PARTICIPATION' && points == 2) ||
             (cardType == 'PRAISE' && points == 10) ||
             (cardType == 'GOLD' && points == 20) ||
             (cardType == 'MEMORIZATION' && points == 6) ||
             (cardType == 'CONFESSION' && points == 4);
    }

    function isValidCardEvent(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'studentId', 'studentName', 'cardType', 'points',
          'servantId', 'servantName', 'monthKey', 'weekKey',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'studentId', 'studentName', 'cardType', 'points',
          'servantId', 'servantName', 'monthKey', 'weekKey',
          'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.groupId == groupId &&
        isNonEmptyString(data.studentId, 80) &&
        isNonEmptyString(data.studentName, 100) &&
        isValidCardPointsPair(data.cardType, data.points) &&
        isNonEmptyString(data.servantId, 64) &&
        isNonEmptyString(data.servantName, 80) &&
        isNonEmptyString(data.monthKey, 12) &&
        isNonEmptyString(data.weekKey, 16) &&
        (!('memberUids' in data) || isBoundedStringList(data.memberUids, 1, 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMonthlyBalance(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'studentId', 'studentName', 'monthKey',
          'totalPoints', 'eventsCount', 'lastUpdatedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'studentId', 'studentName', 'monthKey',
          'totalPoints', 'eventsCount', 'lastUpdatedByUid',
          'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.groupId == groupId &&
        isNonEmptyString(data.studentId, 80) &&
        isNonEmptyString(data.studentName, 100) &&
        isNonEmptyString(data.monthKey, 12) &&
        data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 100000 &&
        data.eventsCount is int && data.eventsCount >= 0 && data.eventsCount <= 10000 &&
        isNonEmptyString(data.lastUpdatedByUid, 64) &&
        (!('memberUids' in data) || isBoundedStringList(data.memberUids, 1, 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. User Profiles (Strict Owner Isolation for PII & Personal Preferences)
    match /users/{userId} {
      allow get: if isDocOwner(userId);
      allow list: if false;
      allow create: if isDocOwner(userId) && isValidUserProfile(incoming());
      allow update: if isDocOwner(userId) &&
        isValidUserProfile(incoming()) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isDocOwner(userId);
    }

    // 2. Groups (Admin + up to 6 Servants)
    match /groups/{groupId} {
      // Any signed-in user who knows the exact inviteCode (document ID) can fetch the group to join it.
      allow get: if isSignedIn();
      // Listing groups is only allowed for groups where the user is already a member.
      allow list: if isSignedIn() && uid() in existing().memberUids;

      allow create: if isSignedIn() &&
        incoming().adminId == uid() &&
        isValidGroup(incoming(), groupId);

      // Admin can update group settings & memberUids;
      // A joining servant can append ONLY their own UID to memberUids (up to 7 members total) if not banned,
      // or a leaving servant can remove ONLY their own UID from memberUids.
      allow update: if isSignedIn() &&
        isValidGroup(incoming(), groupId) &&
        incoming().adminId == existing().adminId &&
        incoming().inviteCode == existing().inviteCode &&
        incoming().createdAt == existing().createdAt &&
        (
          existing().adminId == uid() ||
          uid() in existing().memberUids ||
          (
            uid() in incoming().memberUids &&
            !('bannedUids' in existing() && uid() in existing().bannedUids) &&
            incoming().memberUids.size() == existing().memberUids.size() + 1 &&
            incoming().memberUids.hasAll(existing().memberUids) &&
            incoming().name == existing().name &&
            incoming().allowServantUndo == existing().allowServantUndo &&
            incoming().enforceWeeklyCardLimit == existing().enforceWeeklyCardLimit &&
            incoming().maxMonthlyPoints == existing().maxMonthlyPoints
          )
        );

      allow delete: if isSignedIn() && existing().adminId == uid();

      // 2a. Group Invitations
      match /invitations/{invitationId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupAdmin(groupId) && isValidInvitation(incoming(), groupId);
        allow update: if isGroupMember(groupId) &&
          isValidInvitation(incoming(), groupId) &&
          incoming().groupId == existing().groupId &&
          incoming().adminId == existing().adminId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isGroupAdmin(groupId);
      }

      // 2b. Servant Blocks
      // Read/List: Any member of the group (queried by groupId).
      // Create/Update: Any member of the group.
      // Delete: Strictly Group Admin ONLY.
      match /blocks/{blockId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && isValidServantBlock(incoming(), groupId);
        allow update: if isGroupMember(groupId) &&
          isValidServantBlock(incoming(), groupId) &&
          incoming().groupId == existing().groupId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isGroupAdmin(groupId);
      }

      // 2c. Students (Children)
      // Read/List: Any member of the group (queried by groupId — no stale memberUids array dependency!).
      // Create/Update: Any member of the group (supports adding, editing, moving blocks, and fractional position).
      // Delete: Strictly Group Admin ONLY.
      match /students/{studentId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          isValidStudent(incoming(), groupId);
        allow update: if isGroupMember(groupId) &&
          isValidStudent(incoming(), groupId) &&
          incoming().groupId == existing().groupId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isGroupAdmin(groupId);
      }

      // 2d. Card Events (7 Approved Cards Audit Log)
      // Read/List: Any member of the group.
      // Create/Update: Any member of the group.
      // Delete (Undo): Group Admin OR Servant who recorded the event when allowServantUndo is enabled.
      match /cardEvents/{eventId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          incoming().servantId == uid() &&
          isValidCardEvent(incoming(), groupId);
        allow update: if isGroupMember(groupId) &&
          isValidCardEvent(incoming(), groupId) &&
          incoming().groupId == existing().groupId &&
          incoming().studentId == existing().studentId &&
          incoming().cardType == existing().cardType &&
          incoming().points == existing().points;
        allow delete: if isGroupAdmin(groupId) ||
          (
            isGroupMember(groupId) &&
            existing().servantId == uid() &&
            groupAllowsServantUndo(groupId)
          );
      }

      // 2e. Monthly Balances
      match /monthlyBalances/{balanceId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          isValidMonthlyBalance(incoming(), groupId);
        allow update: if isGroupMember(groupId) &&
          isValidMonthlyBalance(incoming(), groupId) &&
          incoming().groupId == existing().groupId &&
          incoming().studentId == existing().studentId &&
          incoming().monthKey == existing().monthKey;
        allow delete: if isGroupAdmin(groupId);
      }
    }
  }
}
